# Server-only settings. None of these reach the browser.

# Required. Drives the predicted comments and the practice chat.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini: 4.8s per run against 44s for gpt-5-mini.
OPENAI_MODEL=gpt-4o-mini

# Only needed for the viral score (mục ①), which calls the Python service.
# Leave unset and that panel reports the backend is unreachable; everything else runs.
AI_SERVER_URL=http://127.0.0.1:8000
AI_SERVER_TOKEN=
